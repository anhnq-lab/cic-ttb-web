# ===========================================
# CIC Website - Environment Configuration
# ===========================================
# Copy file này thành .env.local và điền giá trị phù hợp

# Server Configuration
NODE_ENV=production
PORT=3000

# AI Configuration (Google Gemini)
# Lấy API key tại: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (Vite)
# API URL cho production (để trống nếu backend và frontend cùng domain)
VITE_API_URL=/api
VITE_USE_REAL_API=true

# Google Analytics (Optional)
# Lấy Measurement ID tại: https://analytics.google.com
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager (Optional)
GTM_CONTAINER_ID=GTM-XXXXXXX
